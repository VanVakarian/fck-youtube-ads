{
  "manifest_version": 3,
  "name": "Fck youtube ads",
  "description": "Youtube ad skipper",
  "version": "1.0.0",
  "minimum_chrome_version": "130",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "diagnostics.js",
        "hide-rules.js",
        "hide.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "128": "images/logo.png"
  },
  "commands": {},
  "externally_connectable": {
    "matches": [
      "https://www.youtube.com/*"
    ]
  },
  "options_page": "",
  "web_accessible_resources": []
}
